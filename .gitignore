# Environment — never commit real secrets
.env
*.env.local

# Local fork notes (kept on the host only)
/AGENTS.md

# Local docker compose overrides (e.g. temporary LOG_LEVEL=debug for a soak) — never committed
docker-compose.override.yml

# Dependencies
node_modules/

# Build output
frontend/dist/
frontend/.vite/
frontend/packages/release/

# TLS certs (generated locally or via Let's Encrypt)
certs/

# Runtime data (Postgres/Redis bind mounts on the host)
/data/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

.superpowers/
output/
